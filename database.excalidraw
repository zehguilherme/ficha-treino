      "text": "Exercises\n\n- ID: VARCHAR(100) (PK)\n- NAME: VARCHAR(255) NOT NULL\n- FORCE: VARCHAR(10) NULL\n- LEVEL: VARCHAR(20) NULL\n- MECHANIC: VARCHAR(10) NULL\n- EQUIPMENT: VARCHAR(50) NULL\n- PRIMARY_MUSCLES: TEXT[] NOT NULL\n- SECONDARY_MUSCLES: TEXT[] NOT NULL\n- INSTRUCTIONS: TEXT[] NOT NULL\n- CATEGORY: VARCHAR(30) NULL\n- IMAGES: TEXT[] NOT NULL\n- CUSTOM_WORKOUT_ID: INTEGER NULL (FK →\nWORKOUTS.ID)\n- IS_CUSTOM: BOOLEAN NOT NULL DEFAULT FALSE\n- CREATED_AT: TIMESTAMPTZ DEFAULT NOW()\n- UPDATED_AT: TIMESTAMPTZ (@updatedAt)\n- INDEX (CUSTOM_WORKOUT_ID)\n- CUSTOM_WORKOUT_ID FK: ON DELETE CASCADE\n\nCHECK:\n- is_custom = TRUE → custom_workout_id NOT NULL\n- is_custom = FALSE → custom_workout_id IS NULL",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "twaWCx-rIQ5njnNzHaeD3",
      "originalText": "Exercises\n\n- ID: VARCHAR(100) (PK)\n- NAME: VARCHAR(255) NOT NULL\n- FORCE: VARCHAR(10) NULL\n- LEVEL: VARCHAR(20) NULL\n- MECHANIC: VARCHAR(10) NULL\n- EQUIPMENT: VARCHAR(50) NULL\n- PRIMARY_MUSCLES: TEXT[] NOT NULL\n- SECONDARY_MUSCLES: TEXT[] NOT NULL\n- INSTRUCTIONS: TEXT[] NOT NULL\n- CATEGORY: VARCHAR(30) NULL\n- IMAGES: TEXT[] NOT NULL\n- CUSTOM_WORKOUT_ID: INTEGER NULL (FK → WORKOUTS.ID)\n- IS_CUSTOM: BOOLEAN NOT NULL DEFAULT FALSE\n- CREATED_AT: TIMESTAMPTZ DEFAULT NOW()\n- UPDATED_AT: TIMESTAMPTZ (@updatedAt)\n- INDEX (CUSTOM_WORKOUT_ID)\n- CUSTOM_WORKOUT_ID FK: ON DELETE CASCADE\n\nCHECK:\n- is_custom = TRUE → custom_workout_id NOT NULL\n- is_custom = FALSE → custom_workout_id IS NULL",
