{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --include=dev --legacy-peer-deps",
  "buildCommand": "npm run swagger:gen && npm run build && npm run migrate:deploy",
  "outputDirectory": "dist",
  "framework": null,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.ts"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "{src/generated/prisma/**,node_modules/swagger-ui-dist/**}"
    }
  }
}
